{
  "family": "fraud-detection-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/fraud-detection-execution-role",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/fraud-detection-task-role",
  "containerDefinitions": [
    {
      "name": "fraud-api",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/fraud-detection-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "MODEL_PATH", "value": "models/xgboost_fraud_model.pkl" },
        { "name": "FEATURE_COLUMNS_PATH", "value": "models/feature_columns.json" },
        { "name": "THRESHOLD_OTP", "value": "0.30" },
        { "name": "THRESHOLD_REVIEW", "value": "0.60" },
        { "name": "THRESHOLD_BLOCK", "value": "0.85" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fraud-detection-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "fraud-api"
        }
      }
    }
  ]
}